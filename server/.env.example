NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/resume-builder
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Retained name for migration; this is now an HMAC secret, not a JWT signing key.
JWT_SECRET=
SESSION_HOURS=12
MAX_FILE_SIZE=5242880
# Optional absolute directory. Required durable private volume until M2 object storage.
UPLOAD_PATH=
# Comma-separated trusted proxy IPs/CIDRs only after the deployed hop chain is verified.
TRUST_PROXY=
# Optional for identity and uploads; AI endpoints report 503 when OpenAI is missing.
OPENAI_API_KEY=
GROQ_API_KEY=

